# Local development only. Nothing here reaches anything but 127.0.0.1.
#
# The Supabase container name is <service>_<project-dir>, so it tracks this
# repo's directory name. If you rename the checkout, update PS_DATA_SOURCE_URI.
PS_DATA_SOURCE_URI=postgresql://powersync_role:powersync_local_dev@supabase_db_MarinaSecureDocs:5432/postgres
PS_STORAGE_SOURCE_URI=postgresql://powersync:powersync@ps-storage:5432/powersync_storage
PS_JWKS_URL=https://present-penguin-25.clerk.accounts.dev/.well-known/jwks.json
PS_PORT=8080
SUPABASE_NETWORK=supabase_network_MarinaSecureDocs
