{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:check": "node scripts/coverage-check.mjs",
    "schema:gen": "node scripts/generate-client-schema.mjs",
    "schema:check": "node scripts/generate-client-schema.mjs --check",
    "test:db": "supabase test db",
    "seed": "node scripts/seed/index.mjs",
    "ps:up": "docker compose -f powersync/docker-compose.yaml --env-file powersync/local.env up -d",
    "ps:down": "docker compose -f powersync/docker-compose.yaml --env-file powersync/local.env down",
    "ps:reset": "docker compose -f powersync/docker-compose.yaml --env-file powersync/local.env down -v && docker compose -f powersync/docker-compose.yaml --env-file powersync/local.env up -d",
    "ps:logs": "docker compose -f powersync/docker-compose.yaml --env-file powersync/local.env logs -f powersync"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@journeyapps/wa-sqlite": "^2.0.3",
    "@powersync/react": "^2.0.0",
    "@powersync/web": "^2.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "rrule": "^2.8.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@instantdb/admin": "^1.0.52",
    "@instantdb/react": "^1.0.49",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.71.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
