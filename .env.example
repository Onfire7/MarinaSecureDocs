# Per-marina environment (see docs: Stack & Architecture — Per-marina isolation).
# Copy to .env.local and fill in the values for this marina's deployment.

# The marina's InstantDB app id (InstantDB dashboard).
VITE_INSTANT_APP_ID=

# The marina's Clerk application publishable key. The Clerk application must
# have multi-session enabled (shared-device User Switch) and a JWT template
# registered on the InstantDB app so Instant trusts Clerk sessions.
VITE_CLERK_PUBLISHABLE_KEY=

# Name of the Clerk client configured on the InstantDB app (defaults to "clerk").
VITE_INSTANT_CLERK_CLIENT_NAME=clerk

# ── Migration target: Supabase + PowerSync ────────────────────────────────
# Provisioned by `bash scripts/provision-supabase.sh`, which writes these to
# .env.local. See docs/adr/0005-supabase-and-powersync-replace-instantdb.md.
#
# Public by design — these ship in the browser bundle. The anon key grants
# nothing on its own; RLS evaluates against the Clerk JWT.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_POWERSYNC_URL=

# Not public. Used to configure the PowerSync↔Postgres connection; never
# compiled into the bundle and never added to Netlify.
POWERSYNC_DB_PASSWORD=
SUPABASE_DB_HOST=

# Clerk's domain and the JWKS URL derived from it. Supabase trusts the domain
# as a third-party auth provider; PowerSync verifies tokens against the JWKS.
CLERK_DOMAIN=
CLERK_JWKS_URL=
